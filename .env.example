TELEGRAM_BOT_TOKEN=replace_with_a_new_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
HOTEL_ALERT_DROP_PERCENTAGE=10
HOTEL_ALERT_COOLDOWN_HOURS=24
HOTEL_NOTIFY_CURRENT_PRICE=false
HOTEL_CITY=台北
HOTEL_CITY_ID=617
HOTEL_CITY_SLUG=taipei
HOTEL_TARGET_NAMES=
# Optional multi-city watchlist:
# HOTEL_TARGETS=高雄|720|kaohsiung|hotel-name;台北|617|taipei|hotel-name
# Optional exact hotel detail watchlist. Use this when a hotel is not in the
# city's featured list. If set, it takes priority over HOTEL_TARGETS.
HOTEL_TARGET_DETAILS=台北|路徒PLUS行旅-主題館|https://hk.trip.com/hotels/detail/?cityEnName=Taipei&cityId=617&hotelId=78247238
HOTEL_CURRENCY=HKD
HOTEL_LOCALE=zh-TW
HOTEL_ADULTS=2
HOTEL_CHILDREN=0
HOTEL_HEADFUL=false
# Optional on Windows when using an installed Chrome executable:
# HOTEL_EXECUTABLE_PATH=
# Optional CDP mode. Start a dedicated Chrome with remote debugging,
# sign in normally if Trip.com requests it, then let the scraper reuse its tab.
# HOTEL_CDP_URL=http://127.0.0.1:9222
# Docker Desktop for macOS:
# HOTEL_CDP_URL=http://host.docker.internal:9222
# HOTEL_CDP_HOST_HEADER=localhost:9222
# HOTEL_REUSE_CURRENT_PAGE=true
HOTEL_CHECK_IN=2026-10-07
HOTEL_CHECK_OUT=2026-10-11
HOTEL_TIMEOUT_MS=30000
HOTEL_INTERVAL_HOURS=1
# Flight monitor settings used by the local compose.yaml service:
CHECK_INTERVAL_HOURS=1
RUN_ONCE=0
# Optional flight CDP mode. Start a separate Chrome profile, open Trip.com,
# and complete any verification manually before the agent reads the page.
# Docker Desktop for macOS reaches the host browser through this address:
# TRIP_CDP_URL=http://host.docker.internal:9222
# Optional when Chrome rejects Docker's hostname; localhost:9222 is the normal value.
# TRIP_CDP_HOST_HEADER=localhost:9222
TRIP_REUSE_CURRENT_PAGE=true
TRIP_MANUAL_VERIFY_TIMEOUT_SECONDS=180
