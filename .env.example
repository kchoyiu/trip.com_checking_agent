TELEGRAM_BOT_TOKEN=replace_with_a_new_botfather_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
HOTEL_ALERT_DROP_PERCENTAGE=10
HOTEL_ALERT_COOLDOWN_HOURS=24
HOTEL_NOTIFY_CURRENT_PRICE=false
HOTEL_CITY=高雄
HOTEL_CITY_ID=720
HOTEL_CITY_SLUG=kaohsiung
HOTEL_TARGET_NAMES=
# Optional multi-city watchlist:
# HOTEL_TARGETS=高雄|720|kaohsiung|喜迎旅店;新北|7662|new-taipei-city|傑仕堡有氧;台北|617|taipei|路徒PLUS行旅-主題館
# Optional exact hotel detail watchlist. Use this when a hotel is not in the
# city's featured list. If set, it takes priority over HOTEL_TARGETS.
# HOTEL_TARGET_DETAILS=高雄|喜迎旅店|https://hk.trip.com/hotels/detail/?cityEnName=Kaohsiung&cityId=720&hotelId=7932167;新北|傑仕堡有氧飯店|https://hk.trip.com/hotels/detail/?cityEnName=New%20Taipei%20City&cityId=7662&hotelId=63341173;台北|路徒PLUS行旅-主題館|https://hk.trip.com/hotels/detail/?cityEnName=Taipei&cityId=617&hotelId=78247238
HOTEL_CURRENCY=TWD
HOTEL_LOCALE=zh-HK
HOTEL_ADULTS=2
HOTEL_CHILDREN=0
HOTEL_HEADFUL=false
# Optional on Windows when using an installed Chrome executable:
# HOTEL_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional Windows CDP mode. Start a dedicated Chrome with remote debugging,
# sign in normally if Trip.com requests it, then let the scraper reuse its tab.
# HOTEL_CDP_URL=http://127.0.0.1:9222
# HOTEL_REUSE_CURRENT_PAGE=true
HOTEL_CHECK_IN=2026-10-04
HOTEL_CHECK_OUT=2026-10-07
HOTEL_TIMEOUT_MS=30000
HOTEL_INTERVAL_HOURS=6
